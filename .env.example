PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/choir
JWT_SECRET=change-this-to-a-long-random-string
# Production: use a random string of at least 32 characters (e.g. openssl rand -hex 32)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_MS=604800000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=10000
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@stpauls.parish
ADMIN_PASSWORD=choiradmin
# Wall-clock parsing for bare YYYY-MM-DDTHH:mm payloads (API/scripts). Default: Asia/Kolkata.
# EVENT_TIMEZONE=Asia/Kolkata
